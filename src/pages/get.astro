---
/**
 * /get — smart store link.
 * In production the Worker in worker/index.js answers this route at the edge
 * (see wrangler.jsonc → run_worker_first). This static page is the fallback for
 * `astro dev`/other hosts: it redirects client-side and shows both store links
 * if scripts are off.
 */
import Base from '../layouts/Base.astro'
import StoreBadges from '../components/StoreBadges.astro'
import { ANDROID_DOWNLOAD_URL, IOS_DOWNLOAD_URL } from '../lib/site'
---

<Base title="Get the app" description="Sending you to closed testing for your device." minimal noindex>
  <section class="wrap">
    <div class="card">
      <h1>Taking you to closed testing…</h1>
      <p class="muted">If nothing happens, pick your platform and opt in.</p>
      <StoreBadges campaign="get_fallback" align="center" />
    </div>
  </section>
  <script is:inline define:vars={{ ANDROID_DOWNLOAD_URL, IOS_DOWNLOAD_URL }}>
    const ua = navigator.userAgent
    const c = new URLSearchParams(location.search).get('c') || 'get'
    function go(base) {
      const target = new URL(base)
      target.searchParams.set('utm_source', 'website')
      target.searchParams.set('utm_medium', 'referral')
      target.searchParams.set('utm_campaign', c)
      location.replace(target.toString())
    }
    if (/android/i.test(ua)) go(ANDROID_DOWNLOAD_URL)
    else if (/iphone|ipad|ipod/i.test(ua)) go(IOS_DOWNLOAD_URL)
    else location.replace('/download')
  </script>
</Base>

<style>
  .wrap {
    min-height: 80vh;
    display: grid;
    place-items: center;
    padding: var(--space-6);
  }
  .card {
    text-align: center;
    display: grid;
    gap: var(--space-4);
    justify-items: center;
  }
  h1 {
    font-size: 1.8rem;
  }
</style>
