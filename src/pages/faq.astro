---
import Base from '../layouts/Base.astro'
import { FAQ } from '../lib/faq'

const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Base
  title="FAQ"
  description="Answers to the questions people ask before joining Bondfires: what a camp is, whether it’s free, who can see your videos, and how to bring your existing group."
  jsonLd={ld}
>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">FAQ</p>
      <h1>Questions, answered.</h1>
      <div class="list">
        {
          FAQ.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="more muted">
        Still wondering about something? <a href="/support">Support</a> reaches the two people who built
        this.
      </p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 760px;
  }
  h1 {
    margin-bottom: var(--space-6);
  }
  .list details {
    border-bottom: 1px solid var(--iron);
  }
  .list details:first-child {
    border-top: 1px solid var(--iron);
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 20px 0;
    font-weight: 600;
    font-size: 1.1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--copper);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 400;
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    color: var(--ash);
    margin: 0 0 20px;
    max-width: 62ch;
    font-size: 1.05rem;
  }
  .more {
    margin-top: var(--space-6);
  }
</style>
