---
import Logo from './Logo.astro'
import { NAV } from '../lib/site'
const current = Astro.url.pathname.replace(/\.html$/, '')
---

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Bondfires home"><Logo /></a>

    <nav aria-label="Primary">
      <ul class="links" id="nav-links">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="cta">
          <a href="/download" class="btn btn-primary" data-track="nav_download_click">Get the app</a>
        </li>
      </ul>
    </nav>

    <button
      class="menu"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-links"
      id="nav-toggle"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(20, 20, 22, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--iron);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: var(--space-5);
  }
  .brand:hover {
    text-decoration: none;
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a:not(.btn) {
    color: var(--ash);
    font-weight: 500;
    font-size: 0.97rem;
  }
  .links a:not(.btn):hover,
  .links a[aria-current='page'] {
    color: var(--smoke);
    text-decoration: none;
  }
  .links .btn {
    padding: 11px 18px;
    font-size: 0.95rem;
  }
  .menu {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    background: transparent;
    border: 1px solid var(--iron);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0 10px;
  }
  .menu span {
    display: block;
    height: 2px;
    background: var(--smoke);
    border-radius: 2px;
  }
  @media (max-width: 860px) {
    .menu {
      display: flex;
    }
    nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 68px;
      background: var(--obsidian);
      border-bottom: 1px solid var(--iron);
      display: none;
    }
    nav.open {
      display: block;
    }
    .links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-3) var(--space-5) var(--space-5);
    }
    .links li a:not(.btn) {
      display: block;
      padding: 14px 0;
      border-bottom: 1px solid var(--iron);
      font-size: 1.05rem;
    }
    .links .cta {
      margin-top: var(--space-4);
    }
    .links .cta .btn {
      width: 100%;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle')
  const nav = toggle?.closest('.nav-inner')?.querySelector('nav')
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
  })
</script>
