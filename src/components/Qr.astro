---
import QRCode from 'qrcode'
interface Props {
  url: string
  label: string
  size?: number
}
const { url, label, size = 160 } = Astro.props
const svg = await QRCode.toString(url, {
  type: 'svg',
  margin: 1,
  color: { dark: '#141416', light: '#ffffff' },
  errorCorrectionLevel: 'M',
})
---

<figure class="qr" style={`--size:${size}px`}>
  <div class="code" set:html={svg} aria-hidden="true" />
  <figcaption>
    <span>{label}</span>
    <small class="muted">{url.replace(/^https?:\/\//, '')}</small>
  </figcaption>
</figure>

<style>
  .qr {
    margin: 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .code {
    width: var(--size);
    height: var(--size);
    background: #fff;
    padding: 8px;
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 1px var(--iron), 0 20px 50px -30px var(--copper);
  }
  .code :global(svg) {
    width: 100%;
    height: 100%;
  }
  figcaption {
    display: grid;
    gap: 2px;
    font-weight: 600;
  }
  figcaption small {
    font-weight: 400;
    font-size: 0.8rem;
  }
</style>
