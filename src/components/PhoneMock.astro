---
/**
 * A phone frame. Pass `src` to show a real app screenshot (preferred).
 * Without `src` it renders a faithful CSS rendering of the Home screen, built
 * from the real UI structure (Ember Rail on top, unread threads below), so the
 * page never ships an empty frame.
 */
interface Props {
  src?: string
  alt?: string
  class?: string
  /** Which built-in rendering to show when there is no screenshot. */
  screen?: 'home' | 'thread' | 'camps'
  tilt?: boolean
}
const { src, alt = 'The Bondfires app', class: className = '', screen = 'home', tilt = false } = Astro.props

const rail = [
  { name: 'Marcus', unread: 3, tone: '#6B5B95' },
  { name: 'Dad', unread: 1, tone: '#3C6E71' },
  { name: 'Theo', unread: 0, tone: '#8A5A44', spark: true },
  { name: 'Jake', unread: 2, tone: '#4B6587' },
  { name: 'Ren', unread: 0, tone: '#5B7B5A' },
]
const threads = [
  { title: 'The thing I didn’t say at dinner', camp: 'Thursday Guys', who: 'Marcus', when: '2h', unread: 3, tone: '#6B5B95' },
  { title: 'Job offer. Take it?', camp: 'Hearth', who: 'Dad', when: '5h', unread: 1, tone: '#3C6E71' },
  { title: 'Week 6 of the program', camp: 'Basecamp', who: 'Jake', when: '1d', unread: 2, tone: '#4B6587' },
]
---

<div class={`phone ${tilt ? 'tilt' : ''} ${className}`}>
  <div class="screen">
    {
      src ? (
        <img src={src} alt={alt} width="390" height="844" loading="eager" decoding="async" />
      ) : (
        <div class={`ui ui-${screen}`} role="img" aria-label="Rendering of the Bondfires home screen showing the Ember Rail and unread threads">
          <div class="status">
            <span>9:41</span>
            <span class="dots"><i></i><i></i><i></i></span>
          </div>
          <div class="title">
            <span class="h">Home</span>
            <span class="avatar you">D</span>
          </div>
          <div class="rail">
            <div class="tile lead">
              <span class="flame">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="#D97736" aria-hidden="true"><path d="M12 2c.5 3.3 2.5 5.1 4.3 7.2 1.8 2 3.4 4.1 3.4 7.1 0 4.3-3.5 7.4-7.7 7.4S4.3 20.6 4.3 16.3c0-2.8 1.4-4.7 3-6.5 0 1.7.7 2.9 1.9 3.4C8.7 8.9 10.3 5.8 12 2Z"/></svg>
              </span>
              <span class="lbl">All fires</span>
            </div>
            {rail.map((r) => (
              <div class={`tile ${r.unread ? 'unread' : ''} ${r.spark ? 'spark' : ''}`}>
                <span class="ring">
                  <span class="avatar" style={`background:${r.tone}`}>{r.name[0]}</span>
                  {r.unread > 0 && <span class="badge">{r.unread}</span>}
                  {r.spark && <span class="sparkdot"></span>}
                </span>
                <span class="lbl">{r.name}</span>
              </div>
            ))}
          </div>
          <div class="sec">New for you</div>
          <div class="list">
            {threads.map((t) => (
              <div class="row">
                <span class="avatar lg" style={`background:${t.tone}`}>{t.who[0]}</span>
                <span class="meta">
                  <span class="t">{t.title}</span>
                  <span class="s">{t.camp} · {t.who} · {t.when}</span>
                </span>
                <span class="count">{t.unread}</span>
              </div>
            ))}
          </div>
          <div class="sec">Discover</div>
          <div class="disc">
            <span class="chip">Dads of teenagers</span>
            <span class="chip">Sunday reset</span>
            <span class="chip">Founders, quietly</span>
          </div>
          <div class="tabs">
            <span>Camps</span><span class="on">Home</span><span class="sparkbtn">+</span><span>Profile</span>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    max-width: 330px;
    aspect-ratio: 390 / 844;
    border-radius: 44px;
    background: #0b0b0d;
    padding: 10px;
    box-shadow:
      0 0 0 1px #2c2e33,
      0 0 0 3px #101114,
      0 40px 90px -30px rgba(0, 0, 0, 0.9),
      0 0 120px -20px var(--glow);
  }
  .phone.tilt {
    transform: rotate(-4deg) translateY(6px);
  }
  .phone::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 96px;
    height: 26px;
    background: #0b0b0d;
    border-radius: 16px;
    z-index: 3;
  }
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 36px;
    overflow: hidden;
    background: var(--obsidian);
  }
  .screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* CSS rendering of the Home screen */
  .ui {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 14px 14px 0;
    font-size: 11.5px;
    color: var(--smoke);
    font-family: var(--body);
  }
  .status {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px 0;
    color: var(--smoke);
  }
  .dots {
    display: inline-flex;
    gap: 3px;
    align-items: center;
  }
  .dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--smoke);
    opacity: 0.85;
  }
  .title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 26px 2px 12px;
  }
  .title .h {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-weight: 600;
    font-size: 12px;
    color: #fff;
    background: var(--charcoal);
  }
  .avatar.you {
    background: var(--ember);
  }
  .avatar.lg {
    width: 38px;
    height: 38px;
    font-size: 14px;
  }
  .rail {
    display: flex;
    gap: 10px;
    overflow: hidden;
    padding: 2px 0 6px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    width: 52px;
    flex-shrink: 0;
  }
  .tile .lbl {
    font-size: 9.5px;
    color: var(--ash);
    white-space: nowrap;
  }
  .tile.lead .flame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--gunmetal);
    border: 1px solid var(--iron);
  }
  .ring {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid transparent;
  }
  .ring .avatar {
    width: 38px;
    height: 38px;
  }
  .tile.unread .ring {
    border-color: var(--copper);
    box-shadow: 0 0 14px -4px var(--copper);
  }
  .badge {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--copper);
    color: #fff;
    font-size: 9.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--obsidian);
  }
  .sparkdot {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--gold);
    border: 2px solid var(--obsidian);
  }
  .sec {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
    margin: 14px 2px 8px;
  }
  .list {
    display: grid;
    gap: 8px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--gunmetal);
    border: 1px solid var(--iron);
    border-radius: 12px;
    padding: 9px 10px;
  }
  .row .meta {
    display: grid;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .row .t {
    font-weight: 600;
    font-size: 11.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row .s {
    font-size: 9.5px;
    color: var(--ash);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row .count {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--copper);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .disc {
    display: flex;
    gap: 6px;
    overflow: hidden;
  }
  .chip {
    white-space: nowrap;
    font-size: 10px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--iron);
    color: var(--ash);
  }
  .tabs {
    margin-top: auto;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 12px 0 18px;
    border-top: 1px solid var(--iron);
    font-size: 10px;
    color: var(--ash);
  }
  .tabs .on {
    color: var(--copper);
    font-weight: 600;
  }
  .sparkbtn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--copper), var(--ember));
    color: #fff;
    font-size: 20px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
</style>
