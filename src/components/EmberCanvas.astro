---
/** Ambient drifting embers behind the hero. Pure decoration: hidden from AT,
 *  disabled under prefers-reduced-motion, and paused when off-screen. */
---

<canvas class="embers" aria-hidden="true" data-embers></canvas>

<style>
  .embers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.9;
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  document.querySelectorAll<HTMLCanvasElement>('[data-embers]').forEach((canvas) => {
    if (reduce) return
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    type Ember = { x: number; y: number; r: number; vx: number; vy: number; life: number; max: number }
    let embers: Ember[] = []
    let w = 0
    let h = 0
    let raf = 0
    let running = false

    const resize = () => {
      const rect = canvas.getBoundingClientRect()
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      w = rect.width
      h = rect.height
      canvas.width = Math.floor(w * dpr)
      canvas.height = Math.floor(h * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }

    const spawn = (): Ember => {
      const max = 240 + Math.random() * 260
      return {
        x: w * (0.15 + Math.random() * 0.7),
        y: h + 10,
        r: 0.8 + Math.random() * 1.8,
        vx: (Math.random() - 0.5) * 0.25,
        vy: -(0.25 + Math.random() * 0.45),
        life: 0,
        max,
      }
    }

    const count = () => Math.max(14, Math.min(40, Math.floor(w / 28)))

    const tick = () => {
      if (!running) return
      ctx.clearRect(0, 0, w, h)
      while (embers.length < count()) embers.push(spawn())
      for (const e of embers) {
        e.life++
        e.x += e.vx + Math.sin(e.life / 40) * 0.15
        e.y += e.vy
        const t = e.life / e.max
        const alpha = t < 0.15 ? t / 0.15 : t > 0.7 ? Math.max(0, 1 - (t - 0.7) / 0.3) : 1
        const grad = ctx.createRadialGradient(e.x, e.y, 0, e.x, e.y, e.r * 3)
        grad.addColorStop(0, `rgba(240,171,104,${0.9 * alpha})`)
        grad.addColorStop(0.5, `rgba(217,119,54,${0.35 * alpha})`)
        grad.addColorStop(1, 'rgba(217,119,54,0)')
        ctx.fillStyle = grad
        ctx.beginPath()
        ctx.arc(e.x, e.y, e.r * 3, 0, Math.PI * 2)
        ctx.fill()
      }
      embers = embers.filter((e) => e.life < e.max && e.y > -20)
      raf = requestAnimationFrame(tick)
    }

    const start = () => {
      if (running) return
      running = true
      resize()
      tick()
    }
    const stop = () => {
      running = false
      cancelAnimationFrame(raf)
    }

    new IntersectionObserver((entries) => {
      entries.forEach((en) => (en.isIntersecting ? start() : stop()))
    }).observe(canvas)
    window.addEventListener('resize', resize, { passive: true })
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()))
  })
</script>
